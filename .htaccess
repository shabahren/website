DirectoryIndex index.html
Options -Indexes

ErrorDocument 404 /404.html

RedirectMatch 301 ^/writing/?$ /publications/

<IfModule mod_rewrite.c>
RewriteEngine On

# Permanently retire legacy WordPress taxonomy and numeric post URLs.
# Keep these rules before the existing-file check so /?p=123 does not
# resolve to the current homepage.
RewriteRule ^(?:tag|category)(?:/|$) - [G,L,NC]
RewriteCond %{QUERY_STRING} (^|&)p=[0-9]+(?:&|$) [NC]
RewriteRule ^ - [G,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>


# Research Note short links
RedirectMatch 301 ^/research-notes/3/?$ /research-notes/3/beyond-rhetorical-adoption-chinese-narratives-and-elite-causal-beliefs/
RedirectMatch 301 ^/research-notes/1/?$ /research-notes/1/can-stories-get-you-killed/
RedirectMatch 301 ^/research-notes/2/?$ /research-notes/2/from-development-partner-to-order-shaping-actor/
